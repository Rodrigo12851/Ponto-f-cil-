rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permit read and write on employees collection
    match /employees/{employeeId} {
      allow read, write: if true;
    }

    // Permit read and write on companyGeofence configuration
    match /companyGeofence/{docId} {
      allow read, write: if true;
    }

    // Permit read and write on ownerSettings
    match /ownerSettings/{docId} {
      allow read, write: if true;
    }

    // Permit read and write on facialAuditLogs
    match /facialAuditLogs/{logId} {
      allow read, write: if true;
    }
  }
}
